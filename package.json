{
  "name": "halo-theme-next",
  "version": "1.0.0",
  "private": true,
  "description": "Next 8+, a NexT theme for Halo 2 rebuilt with Vite and Thymeleaf.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "build": "tsc && vp build && npx @halo-dev/theme-package-cli",
    "build-only": "tsc && vp build",
    "package": "npx @halo-dev/theme-package-cli",
    "dev": "vp build --watch",
    "check": "vp check --fix",
    "check:config": "node scripts/check-config.mjs",
    "smoke": "node scripts/smoke.mjs",
    "prepare": "vp config",
    "skills:update": "npx skills update"
  },
  "devDependencies": {
    "@halo-dev/theme-package-cli": "^1.1.1",
    "@halo-dev/vite-plugin-halo-theme": "^1.0.3",
    "@types/node": "18.11.9",
    "typescript": "^5.9.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@latest",
    "vite-plus": "latest",
    "yaml": "^2.8.3"
  },
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "overrides": {
      "vite": "npm:@voidzero-dev/vite-plus-core@latest",
      "vitest": "npm:@voidzero-dev/vite-plus-test@latest"
    }
  }
}
